{
  "driver_source": "import json,hashlib\nfrom pathlib import Path\nimport numpy as np\nfrom scipy.stats import rankdata,spearmanr\nfrom rhombus.transport.cohort_audit import retrospective_joint_profiles\np=Path('data/benchmarks/v3_static/basin_steric_diagnostic_v1.json');d=json.loads(p.read_text());rows=[r for r in d['rows'] if r.get('basin') is not None and r.get('mean_displacement_A') is not None];profiles=retrospective_joint_profiles(rows); lookup={r['relaxed_sha256']:r for r in profiles}\ndef metrics(values,y):\n n=len(y); npos=sum(y); nneg=n-npos\n if not npos or not nneg:return {'auc':None,'rho':None,'n':n}\n ranks=rankdata(values);auc=(sum(rank for rank,label in zip(ranks,y) if label)-npos*(npos+1)/2)/(npos*nneg)\n return {'n':n,'positive':npos,'auc':float(auc),'rho':float(spearmanr(values,[r['mean_displacement_A'] for r in rows]).statistic) if len(set(values))>1 else None}\nout={'schema':'retrospective-joint-mobility-v1','source_sha256':hashlib.sha256(p.read_bytes()).hexdigest(),'driver_source':Path('/tmp/rhombus_joint_analysis.py').read_text(),'scope':'EXPLORATORY_SAME_COHORT_NO_EXTERNAL_VALIDATION','qualification':'ABSTAIN','records':[],'metrics':{},'stage1':d['steric_statistics']}\nfor r in rows:\n q=lookup[r['relaxed_sha256']];out['records'].append({'batch_id':r['batch_id'],'formula':r['formula'],'relaxed_sha256':r['relaxed_sha256'],'mean_displacement_A':r['mean_displacement_A'],'channel_ev':r['channel_ev'],'radius_A':r['radius_A'],'x_vac_basin':r['basin']['x_vac_basin'],'host_min_distance_A':r['host_min_distance_A'],**q})\nfor threshold in (.8,1.):\n y=[int(r['mean_displacement_A']>=threshold) for r in rows]\n for name,values in [('joint',[lookup[r['relaxed_sha256']]['score'] for r in rows]),('channel',[-r['channel_ev'] for r in rows]),('radius',[r['radius_A'] for r in rows]),('basin',[r['basin']['x_vac_basin'] for r in rows])]:out['metrics'][str(threshold)+':'+name]=metrics(values,y)\nPath('data/benchmarks/v3_static/joint_mobility_diagnostic_v1.json').write_text(json.dumps(out,indent=2,sort_keys=True,allow_nan=False)+'\\n');print('n',len(rows),'metrics',out['metrics'])\n",
