  "driver_source": "import json,time,hashlib\nfrom pathlib import Path\nimport numpy as np\nfrom rhombus.transport.cif_probe import prepare_cif_evaluation_probe\nfrom rhombus.transport.bvse_parameters import build_charge_scaled_evaluator\nfrom rhombus.transport.bvse_percolation import percolation_thresholds\nfrom rhombus.transport.cohort_audit import geometric_percolation_radius\nbase=Path('data/benchmarks/known_material/structures');paths=[base/'cod/1008166-latest-freeze-v1.cif',base/'cod/9009060-latest-freeze-v1.cif',base/'literature/tetragonal-llzo-awaka-2009-nd-v1.cif'];rows=[];start=time.monotonic();out=Path('data/benchmarks/v3_static/priority1_grid_convergence_v1.json')\nfor p in paths:\n s=prepare_cif_evaluation_probe(p)['structure']\n for h in (.45,.35,.25,.20):\n  shape=np.ceil(np.array(s.lattice.abc)/h).astype(int);row={'path':str(p),'requested_spacing_A':h,'required_shape':shape.tolist()};t=time.monotonic()\n  try:\n   if max(shape)>64 or np.prod(shape)>262144:raise ValueError('unclamped grid exceeds existing 64-axis/262144-voxel budget')\n   host=build_charge_scaled_evaluator(s);field=host.grid(h,min_dimension=2,max_dimension=64);assert list(field.shape)==shape.tolist();graph=percolation_thresholds(field);g=geometric_percolation_radius(s,spacing_A=h,min_dimension=2,max_dimension=64);row.update(status='COMPUTED_UNQUALIFIED',channel_ev=graph['barriers_eV']['3D'],geometry=g)\n  except Exception as e:row.update(status='FAILED',error=repr(e))\n  row['elapsed_seconds']=time.monotonic()-t;rows.append(row);out.write_text(json.dumps({'schema':'priority1-grid-convergence-v1','source_commit':'6709d91c303674fc07edf0be4bc86036c9ea0a3c','driver_source':Path('/tmp/rhombus_grid_convergence.py').read_text(),'source_sha256':hashlib.sha256(Path('rhombus/transport/cohort_audit.py').read_bytes()).hexdigest(),'rows':rows,'qualification':'ABSTAIN','elapsed_seconds':time.monotonic()-start},indent=2,sort_keys=True,allow_nan=False)+'\\n');print(p.name,h,row['status'],flush=True)\