{
  "driver_source": "import json,time,hashlib\nfrom pathlib import Path\nimport numpy as np\nfrom scipy.optimize import minimize\nfrom pymatgen.util.coord import pbc_shortest_vectors\nfrom rhombus.transport.cif_probe import prepare_cif_evaluation_probe\nfrom rhombus.transport.bvse_parameters import build_charge_scaled_evaluator,host_radii\nfrom rhombus.transport.bvse_percolation import percolation_thresholds\nbase=Path('data/benchmarks/known_material/structures'); paths=[base/'cod/9009060-latest-freeze-v1.cif',base/'cod/1008166-latest-freeze-v1.cif',base/'literature/tetragonal-llzo-awaka-2009-nd-v1.cif']; out=Path('data/benchmarks/v3_static/priority2_grid_v1.json'); rows=[]; start=time.monotonic()\nfor path in paths:\n s=prepare_cif_evaluation_probe(path)['structure']; host=build_charge_scaled_evaluator(s); sites=[x.frac_coords for x in s if x.specie.symbol!='Li']; radii=np.asarray(host_radii(s)); lengths=np.asarray(s.lattice.abc)\n for n in ([16,20,24,28,32] if 'llzo' not in path.name else [32,40,48,56,64]):\n  row={'path':str(path),'shape':[n]*3,'actual_spacing_A':(lengths/n).tolist()};t=time.monotonic()\n  try:\n   frac=np.stack(np.meshgrid(*([np.arange(n)/n]*3),indexing='ij'),axis=-1).reshape(-1,3); pts=s.lattice.get_cartesian_coords(frac)\n   field=np.concatenate([host(pts[i:i+2048])[0] for i in range(0,len(pts),2048)]).reshape((n,n,n)); graph=percolation_thresholds(field)\n   clear=np.concatenate([(np.linalg.norm(pbc_shortest_vectors(s.lattice,frac[i:i+128],sites),axis=2)-radii).min(axis=1) for i in range(0,len(frac),128)]).reshape((n,n,n)); cg=percolation_thresholds(-clear)\n   # Local cross-plane optimization is only a witness diagnostic, not a continuous percolation proof.\n   def refine(g,values,objective):\n    target=g['minimum_energy_eV']+g['barriers_eV']['3D']; cycles=g['percolating_cycles']['3D']; candidates=[]\n    for cycle in cycles:\n     p=np.asarray(cycle['fractional_path']); vals=np.array([values[tuple(np.rint((x%1)*n).astype(int)%n)] for x in p]); j=int(np.argmax(vals)); candidates.append((vals[j],p,j))\n    _,p,j=max(candidates,key=lambda q:q[0]); point=p[j]; direction=s.lattice.get_cartesian_coords(p[min(j+1,len(p)-1)]-p[max(j-1,0)]); norm=np.linalg.norm(direction)\n    if norm<1e-12:return None\n    direction/=norm; axis=np.eye(3)[np.argmin(abs(direction))]; u=np.cross(direction,axis);u/=np.linalg.norm(u);v=np.cross(direction,u); origin=s.lattice.get_cartesian_coords(point); bound=max(lengths)/n\n    result=minimize(lambda z: objective(origin+u*z[0]+v*z[1]),[0.,0.],method='Powell',bounds=[(-bound,bound)]*2, options={'maxiter':60,'xtol':1e-5,'ftol':1e-7})\n    return {'value':float(min(objective(origin),result.fun)),'success':bool(result.success),'offset_A':result.x.tolist(),'voxel_threshold':float(target),'scope':'LOCAL_WITNESS_PLANE_NOT_GLOBAL_PERCOLATION'}\n   minfrac=np.array(np.unravel_index(np.argmin(field),field.shape))/n; mincart=s.lattice.get_cartesian_coords(minfrac); scale=lengths/n\n   res=minimize(lambda z: float(host(s.lattice.get_cartesian_coords(minfrac+z/np.array([n]*3))[None,:])[0][0]),[0.,0.,0.],method='Powell',bounds=[(-1,1)]*3,options={'maxiter':80,'xtol':1e-5})\n   er=refine(graph,field,lambda xyz:float(host(xyz[None,:])[0][0]))\n   def negclear(xyz):return -float((np.linalg.norm(pbc_shortest_vectors(s.lattice,[s.lattice.get_fractional_coords(xyz)],sites),axis=2)-radii).min())\n   cr=refine(cg,-clear,negclear)\n   row.update(status='COMPUTED',channel_ev=graph['barriers_eV']['3D'],radius_A=-(cg['minimum_energy_eV']+cg['barriers_eV']['3D']),continuous_min_ev=float(res.fun),min_success=bool(res.success),plane_energy=er,plane_clearance=cr,local_plane_channel_ev=(er['value']-float(res.fun) if er else None),local_plane_radius_A=(-cr['value'] if cr else None))\n  except Exception as e:row.update(status='FAILED',error=repr(e))\n  row['elapsed_seconds']=time.monotonic()-t;rows.append(row);out.write_text(json.dumps({'schema':'priority2-grid-v1','source_commit':'1ea4a5c2ffaaf019c246688c0b7106e3e16bcec0','driver_source':Path('/tmp/priority2_grid.py').read_text(),'rows':rows,'qualification':'ABSTAIN'},indent=2,sort_keys=True,allow_nan=False)+'\\n');print(path.name,n,row['status'],row['elapsed_seconds'],flush=True)\n",
