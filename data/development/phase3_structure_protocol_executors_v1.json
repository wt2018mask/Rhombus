    "engine": "pymatgen.analysis.structure_matcher.StructureMatcher",
    "require_same_reduced_composition": true,
    "primitive_cell": true,
    "scale": true,
    "attempt_supercell": false,
    "ltol": 0.2,
    "stol": 0.3,
    "angle_tol_degrees": 5
  },
  "prototype_group": {
